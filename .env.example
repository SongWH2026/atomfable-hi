# 复制到 Vercel → Project → Settings → Environment Variables（不要提交真实密钥到 Git）

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 可选：Cloudflare Turnstile（不填则暂不验证，建议上线前配置）
TURNSTILE_SECRET_KEY=

# 可选：昵称完全等于此值时标记为站长（如 AtomFable），发帖会高亮
HI_ADMIN_NICK=AtomFable

# 可选：站长删除口令（自己设一串随机字符，只在 Vercel 配置，不要提交到 Git）
HI_ADMIN_SECRET=your-random-secret-here
